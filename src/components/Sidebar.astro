---
import { getCollection } from 'astro:content';
import { navigation, researchNavigation } from '../data/navigation';
import { withBase } from '../lib/paths';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const noteCount = (await getCollection('docs')).length;
---

<nav class="side-navigation" aria-label="All sections">
  <div class="side-navigation-title">
    <span>Field guide</span>
    <small>{noteCount} notes</small>
  </div>
  {
    navigation.map((group) => (
      <details open={group.items.some((item) => item.path === currentPath)}>
        <summary>{group.label}</summary>
        <div>
          {group.items.map((item) => (
            <a href={withBase(item.path)} aria-current={item.path === currentPath ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </div>
      </details>
    ))
  }
  <details class="external-research-navigation">
    <summary>Research site <span aria-hidden="true">↗</span></summary>
    <p>
      Long-form research at research.shunyabar.foo. Every article below opens in a new tab.
    </p>
    <div>
      {researchNavigation.map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${item.label} (opens in a new tab)`}
        >
          <span>{item.label}</span>
          <span class="external-link-mark" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </details>
</nav>
