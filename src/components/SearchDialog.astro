---
import { withBase } from '../lib/paths';

const searchIndexUrl = withBase('/search-index.json');
---

<dialog class="search-dialog" data-search-dialog data-index-url={searchIndexUrl}>
  <div class="search-panel">
    <form class="search-form" method="dialog" onsubmit="return false">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <input
        type="search"
        data-search-input
        autocomplete="off"
        placeholder="Search essays, research, projects…"
        aria-label="Search this site"
      />
      <button type="button" data-search-close aria-label="Close search">Esc</button>
    </form>
    <div class="search-status" data-search-status>Start typing to search all 77 articles and guides.</div>
    <ol class="search-results" data-search-results></ol>
    <footer>
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>↵</kbd> open</span>
      <span>Static, private search</span>
    </footer>
  </div>
</dialog>

<script>
  interface SearchItem {
    title: string;
    description: string;
    path: string;
    section: string;
    text: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]');
  const results = dialog?.querySelector<HTMLOListElement>('[data-search-results]');
  const status = dialog?.querySelector<HTMLElement>('[data-search-status]');
  let index: SearchItem[] | null = null;
  let activeResult = -1;

  async function loadIndex() {
    if (index || !dialog) return;
    const response = await fetch(dialog.dataset.indexUrl!);
    index = await response.json();
  }

  function score(item: SearchItem, terms: string[]) {
    const title = item.title.toLowerCase();
    const description = item.description.toLowerCase();
    const body = item.text.toLowerCase();
    return terms.reduce((total, term) => {
      if (!title.includes(term) && !description.includes(term) && !body.includes(term)) return -10000;
      return total + (title.includes(term) ? 12 : 0) + (description.includes(term) ? 5 : 0) + 1;
    }, 0);
  }

  function renderResults(query: string) {
    if (!index || !results || !status) return;
    const terms = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
    results.replaceChildren();
    activeResult = -1;

    if (!terms.length) {
      status.textContent = 'Start typing to search all 77 articles and guides.';
      return;
    }

    const matches = index
      .map((item) => ({ item, score: score(item, terms) }))
      .filter((result) => result.score > -10000)
      .sort((a, b) => b.score - a.score)
      .slice(0, 8);

    status.textContent = matches.length ? `${matches.length} best matches` : 'No matches. Try a broader phrase.';

    for (const { item } of matches) {
      const row = document.createElement('li');
      const link = document.createElement('a');
      const meta = document.createElement('span');
      const title = document.createElement('strong');
      const excerpt = document.createElement('small');
      link.href = item.path;
      meta.textContent = item.section;
      title.textContent = item.title;
      excerpt.textContent = item.description;
      link.append(meta, title, excerpt);
      row.append(link);
      results.append(row);
    }
  }

  async function openSearch() {
    if (!dialog) return;
    dialog.showModal();
    await loadIndex();
    input?.focus();
  }

  function moveSelection(direction: number) {
    const links = Array.from(results?.querySelectorAll<HTMLAnchorElement>('a') ?? []);
    if (!links.length) return;
    activeResult = (activeResult + direction + links.length) % links.length;
    links[activeResult].focus();
  }

  document.querySelectorAll('[data-search-open]').forEach((button) => button.addEventListener('click', openSearch));
  dialog?.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  input?.addEventListener('input', () => renderResults(input.value));

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      dialog?.open ? dialog.close() : openSearch();
    } else if (dialog?.open && event.key === 'ArrowDown') {
      event.preventDefault();
      moveSelection(1);
    } else if (dialog?.open && event.key === 'ArrowUp') {
      event.preventDefault();
      moveSelection(-1);
    }
  });
</script>
